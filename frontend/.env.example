# Copy to frontend/.env.local for local overrides. Only VITE_* variables reach the browser,
# so never put secrets here.

# Base URL for API calls. Leave as /api/v1 in development (Vite proxies it to Django).
# In production set the absolute API origin, e.g. https://api.myecatalogues.com/api/v1
VITE_API_BASE_URL=/api/v1

# Django dev server the Vite proxy forwards /api and /media to (dev only, not exposed to the browser).
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

VITE_APP_NAME=myEcatalogues
