# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Django ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
# Production only:
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=2592000

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgres://myecatalogues:myecatalogues@localhost:5432/myecatalogues
DATABASE_CONN_MAX_AGE=60
# Optional separate database for the test suite (Django creates test_<name> automatically).
# TEST_DATABASE_URL=postgres://myecatalogues:myecatalogues@localhost:5432/myecatalogues

# --- JWT -------------------------------------------------------------------
# Defaults to DJANGO_SECRET_KEY when unset. Use a separate long random value in production.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Accounts --------------------------------------------------------------
# Lifetimes (seconds) of links sent by email.
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=172800
# Maximum businesses a single user may own.
MAX_BUSINESSES_PER_USER=5

# --- CORS / frontend -------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_CATALOGUE_BASE_URL=http://localhost:5173/c

# --- Media storage ---------------------------------------------------------
MEDIA_URL=/media/
# MEDIA_ROOT=C:\path\to\media   (defaults to backend/media)

# --- Email (Mailpit from docker-compose listens on 1025; UI on http://localhost:8025) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=myEcatalogues <no-reply@myecatalogues.local>

# --- Payments --------------------------------------------------------------
# "mock" is for local development and tests only and never moves real money.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# --- Rate limits -----------------------------------------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_PUBLIC_ENQUIRY=5/min
THROTTLE_PUBLIC_VIEW=120/min
THROTTLE_WEBHOOK=120/min

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# "json" (default in prod) or "console" (default in dev)
# LOG_FORMAT=console
