# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Django ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
# Production only:
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=2592000

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgres://myecatalogues:myecatalogues@localhost:5432/myecatalogues
DATABASE_CONN_MAX_AGE=60
# Optional separate database for the test suite (Django creates test_<name> automatically).
# TEST_DATABASE_URL=postgres://myecatalogues:myecatalogues@localhost:5432/myecatalogues

# --- JWT -------------------------------------------------------------------
# Defaults to DJANGO_SECRET_KEY when unset. Use a separate long random value in production.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Accounts --------------------------------------------------------------
# Lifetimes (seconds) of links sent by email.
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=172800
# Maximum businesses a single user may own.
MAX_BUSINESSES_PER_USER=5

# --- CORS / frontend -------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_CATALOGUE_BASE_URL=http://localhost:5173/c

# --- Media storage ---------------------------------------------------------
MEDIA_URL=/media/
# MEDIA_ROOT=C:\path\to\media   (defaults to backend/media)
# Technical safety caps (plan limits are applied on top of these).
MEDIA_MAX_UPLOAD_MB=100
MEDIA_MAX_ITEMS_PER_PRODUCT=20
MEDIA_MAX_IMAGE_PIXELS=60000000

# --- Email (Mailpit from docker-compose listens on 1025; UI on http://localhost:8025) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=myEcatalogues <no-reply@myecatalogues.local>

# --- Payments --------------------------------------------------------------
# Development (config.settings.dev) defaults to the "mock" gateway, which never moves money.
# Production refuses "mock" and refuses to start without a real provider's secrets.
# Options: "" (online payments disabled), "mock" (dev/tests only), "razorpay" (adapter prepared,
# NOT yet verified against a Razorpay sandbox — see docs/SETUP.md "Payments").
PAYMENT_PROVIDER=mock
# Signs/verifies webhooks. For Razorpay this is the webhook secret from the dashboard.
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Billing ---------------------------------------------------------------
BILLING_CURRENCIES=INR
# Tax is OFF until rates are approved by accounting (e.g. BILLING_TAX_RATE=18.00, BILLING_TAX_NAME=GST).
BILLING_TAX_RATE=0
BILLING_TAX_NAME=
BILLING_PRICES_INCLUDE_TAX=False
BILLING_SELLER_NAME=myEcatalogues
BILLING_SELLER_ADDRESS=
BILLING_SELLER_EMAIL=
BILLING_SELLER_TAX_ID=
BILLING_INVOICE_PREFIX=INV
CHECKOUT_EXPIRY_MINUTES=60
# Days of access after an unpaid period end (0 = none) — pending a business decision.
SUBSCRIPTION_GRACE_DAYS=0
RENEWAL_WINDOW_DAYS=30
# In-app "plan ends soon" reminder window used by `manage.py sync_subscriptions` (days).
SUBSCRIPTION_REMINDER_DAYS=7

# --- Rate limits -----------------------------------------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_PUBLIC_ENQUIRY=5/min
THROTTLE_PUBLIC_VIEW=120/min
THROTTLE_WEBHOOK=120/min

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# "json" (default in prod) or "console" (default in dev)
# LOG_FORMAT=console
